# ============================================================
# NSE Pulse – Environment Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# NSE API Configuration
NSE_BASE_URL=https://www.nseindia.com
NSE_REQUEST_TIMEOUT=30
NSE_RETRY_COUNT=3
NSE_RETRY_BACKOFF_FACTOR=2.0
NSE_RATE_LIMIT_DELAY=1.5

# Storage Paths
OUTPUT_DIR=data/processed
RAW_OUTPUT_DIR=data/raw
REPORTS_DIR=data/reports

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO

# Database (optional – set DB_ENABLED=true to activate)
DB_ENABLED=false
DATABASE_URL=postgresql://nse_user:nse_password@localhost:5432/nse_pulse

# Scheduler (optional – set SCHEDULER_ENABLED=true to activate)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60

